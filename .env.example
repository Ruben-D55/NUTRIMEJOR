# Comunicación interna. Usa valores largos y diferentes en producción.
SERVICE_API_KEY=
JWT_ISSUER=nutrimejor-identity
JWT_AUDIENCE=nutrimejor-services
EXPOSE_DEVELOPMENT_TOKENS=true
ACCESS_TOKEN_MINUTES=10
REFRESH_TOKEN_DAYS=7
# Desarrollo: true. Producción: false y ejecutar scripts/migrate-databases.ps1 como job único.
RUN_MIGRATIONS_ON_STARTUP=true

# Una credencial y una instancia SQL Server por servicio.
IDENTITY_DB_PASSWORD=
PATIENTS_DB_PASSWORD=
CATALOGS_DB_PASSWORD=

# Solo se usan al ejecutar la web fuera de Docker.
IDENTITY_API_URL=http://localhost:4001
PATIENTS_API_URL=http://localhost:4002
CATALOGS_API_URL=http://localhost:4003
SUBSCRIPTIONS_API_URL=http://localhost:4004
CLINICAL_API_URL=http://localhost:4005
MEASUREMENTS_API_URL=http://localhost:4006
NUTRITION_API_URL=http://localhost:4007
PLANNING_API_URL=http://localhost:4008
SCHEDULING_API_URL=http://localhost:4009
NOTIFICATIONS_API_URL=http://localhost:4010
DOCUMENTS_API_URL=http://localhost:4011
REPORTING_API_URL=http://localhost:4012
SERVICE_TIMEOUT_MS=5000
NEXT_PUBLIC_APP_URL=http://localhost:3000
GATEWAY_API_URL=http://localhost:4080
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5050
GATEWAY_TIMEOUT_MS=5000
GATEWAY_RETRIES=2
CIRCUIT_FAILURE_THRESHOLD=5
CIRCUIT_OPEN_MS=30000
GRAFANA_ADMIN_PASSWORD=

# Clave Base64URL de 32 bytes para cifrar y firmar los respaldos (AES-256-GCM/HMAC-SHA256).
BACKUP_ENCRYPTION_KEY=

# Base local compartida por infraestructura; cada servicio crea una base lógica propia.
PLATFORM_DB_PASSWORD=

# Infraestructura asíncrona y archivos.
RABBITMQ_USER=nutrimejor
RABBITMQ_PASSWORD=
