      "gridPos": { "h": 5, "w": 12, "x": 0, "y": 0 },
      "id": 1,
      "options": { "colorMode": "background", "graphMode": "none", "justifyMode": "auto", "orientation": "horizontal", "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "textMode": "auto" },
      "targets": [{ "expr": "probe_success{job=\"api-readiness\"}", "legendFormat": "{{instance}}", "refId": "A" }],
      "title": "Disponibilidad de las 12 APIs",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "mappings": [{ "options": { "0": { "color": "red", "text": "SIN CONEXIÓN" }, "1": { "color": "green", "text": "CONECTADA" } }, "type": "value" }] }, "overrides": [] },
      "gridPos": { "h": 5, "w": 12, "x": 12, "y": 0 },
      "id": 2,
      "options": { "colorMode": "background", "graphMode": "none", "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false } },
      "targets": [{ "expr": "probe_success{job=\"database-connectivity\"}", "legendFormat": "{{instance}}", "refId": "A" }],
      "title": "Conectividad de bases de datos",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 5 },
      "id": 3,
      "options": { "legend": { "displayMode": "table", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "targets": [{ "expr": "histogram_quantile(0.95, sum by (le, service) (rate(nutrimejor_gateway_http_request_duration_seconds_bucket[5m])))", "legendFormat": "{{service}}", "refId": "A" }],
      "title": "Latencia p95 por módulo",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 5 },
      "id": 4,
      "options": { "legend": { "displayMode": "table", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "targets": [{ "expr": "sum by (service, status) (rate(nutrimejor_gateway_http_requests_total[5m]))", "legendFormat": "{{service}} {{status}}", "refId": "A" }],
      "title": "Solicitudes y errores",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "gridPos": { "h": 7, "w": 8, "x": 0, "y": 13 },
      "id": 5,
      "options": { "legend": { "displayMode": "table", "placement": "bottom" } },
      "targets": [{ "expr": "sum by (queue) (rabbitmq_queue_messages_ready)", "legendFormat": "{{queue}}", "refId": "A" }],
      "title": "Eventos pendientes por cola",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "loki", "uid": "loki" },
      "gridPos": { "h": 7, "w": 16, "x": 8, "y": 13 },
